# Nouriva Feature 1 + Feature 4 AI configuration
# Paste your own Google Gemini API key after the equals sign in the local .env file.
# Never upload or share your real API key.
PORT=3000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Optional alternative provider for Feature 4 only:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
